{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.1"
      ]
    },
    "protocol": {
      "type": "string",
      "enum": [
        "reverse"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "type": "string",
      "enum": [
        "proceed",
        "clarify",
        "refuse"
      ]
    },
    "decision_reason": {
      "type": "string",
      "minLength": 1
    },
    "evidence_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "quote"
        ],
        "additionalProperties": false
      }
    },
    "hypotheses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "supporting_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "verification_question": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "statement",
          "supporting_evidence",
          "alternative",
          "verification_question"
        ],
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preserved_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "evidence_id",
          "statement"
        ],
        "additionalProperties": false
      }
    },
    "clarifying_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 3
    },
    "safe_alternative": {
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "recipient_readback": {
              "type": "string",
              "minLength": 1
            },
            "first_impression": {
              "type": "string",
              "minLength": 1
            },
            "findings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  },
                  "possible_reading": {
                    "type": "string",
                    "minLength": 1
                  },
                  "risk": {
                    "type": "string",
                    "enum": [
                      "ambiguity",
                      "unsupported_claim",
                      "missing_condition",
                      "authority",
                      "pressure",
                      "other"
                    ]
                  },
                  "revision_principle": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "answer_evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  },
                  "inserted_answer": {
                    "type": "string"
                  }
                },
                "required": [
                  "quote",
                  "possible_reading",
                  "risk",
                  "revision_principle",
                  "question",
                  "answer_evidence_refs",
                  "inserted_answer"
                ],
                "additionalProperties": false
              }
            },
            "revised_message": {
              "type": "string",
              "minLength": 1
            },
            "sender_task_correction": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "recipient_readback",
            "first_impression",
            "findings",
            "revised_message",
            "sender_task_correction"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "recipient_choices": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "confirm",
          "clarify",
          "decline",
          "escalate"
        ]
      },
      "uniqueItems": true
    },
    "ethical_notice": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "case_id",
    "decision",
    "decision_reason",
    "evidence_used",
    "hypotheses",
    "uncertainties",
    "preserved_conditions",
    "clarifying_questions",
    "safe_alternative",
    "result",
    "recipient_choices",
    "ethical_notice"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reverse output 1.1"
}
